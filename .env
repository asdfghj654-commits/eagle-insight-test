# Eagle Insight Frontend — Environment Configuration

# Local server URL (where the Node.js backend runs)
VITE_API_URL=http://localhost:3001

# Auth mode: api (default) | demo | disabled
# - api: uses real local server auth (recommended)
# - demo: falls back to demo users when server unavailable (dev only)
# - disabled: auto-login as tech001, no password (dev convenience)
VITE_AUTH_MODE=api
