# F-16 Data Proxy Server Configuration

# Server Settings
PORT=3001
API_KEY=your-secure-api-key-here

# Logging
LOG_LEVEL=info

# SQL Database Connections (examples)
# PostgreSQL
# PG_CONNECTION_STRING=postgresql://user:password@localhost:5432/flight_data

# MySQL
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DATABASE=flight_data
# MYSQL_USER=user
# MYSQL_PASSWORD=password

# MSSQL
# MSSQL_SERVER=localhost
# MSSQL_PORT=1433
# MSSQL_DATABASE=flight_data
# MSSQL_USER=user
# MSSQL_PASSWORD=password

# File System Paths
# NAS_BASE_PATH=\\\\server\\share\\flight_data
# LOCAL_DATA_PATH=C:\\FlightData

# Internal API Endpoints
# INTERNAL_API_URL=http://internal-server:8080/api
# INTERNAL_API_KEY=api-key-here
