# Eagle Insight Local MVP Server — Environment Configuration
# Copy this file to .env and customize for your deployment.

# Server port
PORT=3001

# Data directory (where eagle-insight.db is stored)
DATA_DIR=./data

# JWT secret — MUST be changed in any real deployment
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=eagle-insight-local-dev-secret-CHANGE-THIS-IN-PRODUCTION

# JWT session duration (e.g., 8h, 24h, 7d)
JWT_EXPIRES_IN=8h

# Optional static API key for legacy proxy routes (/api/sql, /api/files, etc.)
# Leave empty to disable API key requirement for proxy routes.
API_KEY=

# Log level: error | warn | info | debug
LOG_LEVEL=info
